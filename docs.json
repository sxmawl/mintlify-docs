{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Cardboard Learn",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Home",
          "icon": "house",
          "href": "https://usecardboard.com"
        },
        {
          "anchor": "App",
          "icon": "play",
          "href": "https://app.usecardboard.com"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Docs",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "getting-started/quickstart",
              "getting-started/editor-overview"
            ]
          },
          {
            "group": "AI Editing",
            "pages": [
              "ai-editing/ai-chat",
              "ai-editing/ai-prompts-guide",
              "ai-editing/captions",
              "ai-editing/voiceovers"
            ]
          },
          {
            "group": "Editing Tools",
            "pages": [
              "editing/timeline",
              "editing/media-library",
              "editing/effects-and-transitions",
              "editing/music-and-audio"
            ]
          },
          {
            "group": "Exporting & Sharing",
            "pages": [
              "export/export-your-video",
              "export/formats-and-quality"
            ]
          },
          {
            "group": "Account & Billing",
            "pages": [
              "account/plans-and-pricing",
              "account/manage-your-account"
            ]
          },
          {
            "group": "Support",
            "pages": [
              "support/faq",
              "support/troubleshooting"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:founders@usecardboard.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Cardboard",
      "href": "https://app.usecardboard.com"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/usecardboard"
    }
  },
  "fonts": {
    "family": "Geist",
    "weight": 400,
    "format": "woff"
  }
}
